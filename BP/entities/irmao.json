{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "endernight:irmao",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": { "family": ["nightmare", "irmao", "monster"] },
      "minecraft:health": { "value": 200, "max": 200 },
      "minecraft:movement": { "value": 0.42 },
      "minecraft:movement.basic": {},
      "minecraft:follow_range": { "value": 40, "max": 40 },
      "minecraft:attack": { "damage": 5 },
      "minecraft:knockback_resistance": { "value": 0.8 },
      "minecraft:nameable": {
        "default_trigger": { "event": "nightmare:spawn", "target": "self" }
      },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:despawn": {
        "despawn_from_distance": { "min_distance": 80, "max_distance": 96 }
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "entity_types": [
          {
            "filters": { "test": "is_family", "value": "player" },
            "max_dist": 40
          }
        ],
        "must_see": false,
        "reselect_targets": true
      },
      "minecraft:behavior.melee_attack": {
        "priority": 2,
        "attack_once": false,
        "track_target": true,
        "speed_multiplier": 1.3
      },
      "minecraft:behavior.look_at_player": {
        "priority": 4,
        "look_distance": 12,
        "probability": 0.02
      },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": { "test": "is_family", "value": "player", "operator": "==" },
            "event": "nightmare:spawn",
            "target": "self"
          }
        ]
      }
    },
    "events": {
      "nightmare:spawn": {
        "run_command": {
          "command": [
            "playsound mob.ghast.scream ~ ~ ~ 1.0 0.4",
            "effect @s night_vision 999999 0 true"
          ]
        }
      }
    }
  }
}
